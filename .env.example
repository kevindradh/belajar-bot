# Discord
DISCORD_TOKEN=           # Bot token dari Discord Developer Portal
DISCORD_CLIENT_ID=       # Application ID
DISCORD_GUILD_ID=        # Guild ID untuk development (opsional, untuk register command lokal)

# Supabase
SUPABASE_URL=            # https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=    # service_role key (bukan anon key!) — bypass RLS

# Judge0
JUDGE0_API_URL=          # URL Judge0 self-hosted (contoh: http://your-vps:2358)
JUDGE0_API_KEY=          # API key Judge0 (opsional, tergantung konfigurasi)

# App Config
NODE_ENV=development
TZ=Asia/Jakarta          # Timezone default bot
LOG_LEVEL=info
